# ==============================================================================
# Digital Intelligence SaaS - Environment Variables Template
# ==============================================================================
#
# RULE 1: Server-Only Secrets
# - Any variable WITHOUT "NEXT_PUBLIC_" is strictly private to the server.
# - It is NEVER bundled into client-side JavaScript.
# - Use for API keys, database credentials, service role keys, and webhook secrets.
#
# RULE 2: Public Client Variables
# - Any variable WITH "NEXT_PUBLIC_" is inlined into the client-side JavaScript bundle.
# - It is visible to anyone inspecting browser network/sources.
# - Use ONLY for public URL endpoints, public client keys, or feature flags.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Database & Auth (Supabase) - Future Phase Integration
# ------------------------------------------------------------------------------
# Public Supabase URL (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Public Supabase Anonymous Key (safe for browser; protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-Only Service Role Key (NEVER expose to browser / client code)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_DB_PASSWORD=your-database-password

# ------------------------------------------------------------------------------
# 3. AI Gateway (OmniRoute - NOT OpenRouter)
# ------------------------------------------------------------------------------
# Server-Only OmniRoute credentials
OMNIROUTE_API_KEY=your-omniroute-api-key
OMNIROUTE_BASE_URL=https://api.omniroute.ai/v1

# ------------------------------------------------------------------------------
# 4. Web Scraping & Ingestion (Crawl4AI)
# ------------------------------------------------------------------------------
# Server-Only Crawler service endpoint & secret
CRAWL4AI_SERVICE_URL=http://localhost:11235
CRAWL4AI_API_TOKEN=your-crawl4ai-token
